{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "gitleaks dir . --redact --verbose --ignore-gitleaks-allow --exit-code 2 1>&2",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "semgrep scan --config p/owasp-top-ten --metrics off --error 1>&2 || [ $? -ne 1 ] || exit 2",
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "trivy fs --severity HIGH,CRITICAL --ignore-unfixed --exit-code 2 . 1>&2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
