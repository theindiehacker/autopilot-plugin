{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "dockerd --registry-mirror=https://mirror.gcr.io >> /tmp/dockerd.log 2>&1 &"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && gitleaks dir . --redact --verbose --ignore-gitleaks-allow --exit-code 2 1>&2",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && semgrep scan --config p/owasp-top-ten --metrics off --baseline-commit \"$(git merge-base HEAD origin/HEAD)\" --error --disable-nosem 1>&2 || [ $? -ne 1 ] || exit 2",
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && trivy fs --scanners vuln,misconfig,secret --severity HIGH,CRITICAL --ignore-unfixed --exit-code 2 . 1>&2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
