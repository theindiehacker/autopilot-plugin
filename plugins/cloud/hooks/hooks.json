{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "dockerd --registry-mirror=https://mirror.gcr.io >> /tmp/dockerd.log 2>&1 &"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
