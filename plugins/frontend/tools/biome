#!/bin/sh
# プロジェクトに入っている版を優先する (biome.json の版と揃えるため)。無ければ、ここで固定した版を bunx で動かす
d=$PWD
while [ "$d" != / ]; do
  [ -x "$d/node_modules/.bin/biome" ] && exec "$d/node_modules/.bin/biome" "$@"
  # リポジトリの外は見ない (よそのフォルダの biome を動かさないため)
  [ ! -e "$d/.git" ] || break
  d=$(dirname -- "$d")
done
exec bunx @biomejs/biome@2.6.4 "$@"
