{
  "name": "frontend",
  "displayName": "frontend@indiehacker",
  "version": "0.4.0",
  "description": "TypeScript・Next.js・shadcn/ui・Tailwind CSS・Playwright のフロントエンド開発で使うプラグイン",
  "repository": "https://github.com/theindiehacker/dev-plugins",
  "dependencies": [
    "dev",
    "frontend-design@claude-plugins-official",
    "playwright@claude-plugins-official",
    "context7@claude-plugins-official",
    "shadcn"
  ],
  "lspServers": {
    "typescript": {
      "command": "sh",
      "args": ["-c", "exec \"$(ls node_modules/.bin/tsc */node_modules/.bin/tsc 2>/dev/null | head -1)\" --lsp --stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}