{
  "name": "python",
  "displayName": "python@indiehacker",
  "version": "0.3.1",
  "description": "Python・uv・ruff・ty・import-linter・deptry の開発で使うプラグイン",
  "repository": "https://github.com/theindiehacker/dev-plugins",
  "dependencies": [
    "security-guidance@claude-plugins-official",
    "superpowers@claude-plugins-official"
  ],
  "lspServers": {
    "ty": {
      "command": "sh",
      "args": ["-c", "t=$(ls .venv/bin/ty */.venv/bin/ty 2>/dev/null | head -1); exec \"${t:-$HOME/.local/bin/ty}\" server"],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    }
  }
}
