{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "plugins/*/scripts/*.sh の GitHub Releases の URL の版を更新する (gitleaks・trivy・mise・uv。タグとファイル名の両方の版を置き換える。uv のタグには v が無い)",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/scripts/[^/]+\\.sh$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v?(?<currentValue>[^/\\s]+)/\\S+"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "plugins/*/scripts/*.sh で uv tool install に版を固定した PyPI のツール (semgrep など) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/scripts/[^/]+\\.sh$/"],
      "matchStrings": ["uv tool install (?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[^\\s\"]+)"],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "plugins/*/tools/* で uv run --with に版を固定した PyPI のツール (deptry・import-linter) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/tools/[^/]+$/"],
      "matchStrings": ["--with (?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[^\\s\"]+)"],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "plugins/*/tools/* で bunx に版を固定した npm のツール (biome) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/tools/[^/]+$/"],
      "matchStrings": ["bunx (?<depName>@?[a-zA-Z0-9._/-]+)@(?<currentValue>[0-9][^\\s\"\\\\]*)"],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "description": "plugins/*/scripts/*.sh の releases.hashicorp.com の URL の terraform の版を更新する (ディレクトリとファイル名の両方の版を置き換える)",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/scripts/[^/]+\\.sh$/"],
      "matchStrings": ["https://releases\\.hashicorp\\.com/terraform/(?<currentValue>[0-9][^/\\s]*)/\\S+"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "plugins/*/tools/* で go run に版を固定した Go のツール (golangci-lint) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/tools/[^/]+$/"],
      "matchStrings": ["go run (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>v[^\\s\"]+)"],
      "datasourceTemplate": "go"
    },
    {
      "description": "plugins/*/.claude-plugin/plugin.json で go run に版を固定した gopls を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^plugins/[^/]+/\\.claude-plugin/plugin\\.json$/"],
      "matchStrings": ["\"(?<depName>golang\\.org/x/tools/gopls)@(?<currentValue>v[^\"]+)\""],
      "datasourceTemplate": "go"
    },
    {
      "description": ".claude-plugin/marketplace.json の git-subdir で固定した外部のプラグインの sha を、ref のブランチの最新のコミットに更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.claude-plugin/marketplace\\.json$/"],
      "matchStrings": [
        "\"url\": *\"(?<packageName>https://github\\.com/[^\"]+\\.git)\",\\s*\"path\": *\"[^\"]*\",\\s*\"ref\": *\"(?<currentValue>[^\"]+)\",\\s*\"sha\": *\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "公開から 7 日たった版だけを取り込む。乗っ取られて悪意のあるコードを入れられた版は、公開から数日で見つかり取り下げられることが多い",
      "matchDatasources": ["pypi", "npm", "go"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
