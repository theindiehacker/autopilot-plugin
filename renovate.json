{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "scripts/*/*.sh の GitHub Releases の URL の版を更新する (gitleaks・trivy・mise・uv。タグとファイル名の両方の版を置き換える。uv のタグには v が無い)",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/[^/]+/[^/]+\\.sh$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v?(?<currentValue>[^/\\s]+)/\\S+"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "scripts/*/*.sh で uv tool install に版を固定した PyPI のツール (semgrep など) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/[^/]+/[^/]+\\.sh$/"],
      "matchStrings": ["uv tool install (?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[^\\s\"]+)"],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "tools/* で uv run --with に版を固定した PyPI のツール (deptry・import-linter) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/[^/]+$/"],
      "matchStrings": ["--with (?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[^\\s\"]+)"],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "description": "tools/* で bunx に版を固定した npm のツール (biome・typescript-language-server) を更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^tools/[^/]+$/"],
      "matchStrings": ["bunx (?<depName>@?[a-zA-Z0-9._/-]+)@(?<currentValue>[0-9][^\\s\"\\\\]*)"],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "description": ".claude-plugin/marketplace.json の git-subdir で固定した外部のプラグインの sha を、ref のブランチの最新のコミットに更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.claude-plugin/marketplace\\.json$/"],
      "matchStrings": [
        "\"url\": *\"(?<packageName>https://github\\.com/[^\"]+\\.git)\",\\s*\"path\": *\"[^\"]*\",\\s*\"ref\": *\"(?<currentValue>[^\"]+)\",\\s*\"sha\": *\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "公開から 7 日たった版だけを取り込む。乗っ取られて悪意のあるコードを入れられた版は、公開から数日で見つかり取り下げられることが多い",
      "matchDatasources": ["pypi", "npm"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
